/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob: https://*.facebook.com https://*.fbcdn.net; style-src 'self' 'unsafe-inline' https://unpkg.com; script-src 'self' 'unsafe-eval' https://identity.netlify.com https://unpkg.com https://connect.facebook.net; font-src 'self' data:; frame-src https://www.google.com/maps/ https://www.facebook.com https://web.facebook.com; connect-src 'self' https://*.netlify.com https://*.netlify.app https://api.github.com https://www.facebook.com

/images/*
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable
